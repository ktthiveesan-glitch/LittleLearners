    "Stars, badges and tracing history will be deleted. This cannot be undone." : {
      "localizations" : {
        "si" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "තරු, පදක්කම් සහ ඇඳීම් ඉතිහාසය මකා දැමෙනු ඇත. මෙය අහෝසි කළ නොහැක."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "நட்சத்திரங்கள், பதக்கங்கள் மற்றும் வரைதல் வரலாறு நீக்கப்படும். இதைச் செயல்தவிர்க்க முடியாது."
          }
        }
      }
    },
