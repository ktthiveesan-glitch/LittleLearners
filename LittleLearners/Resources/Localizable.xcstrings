    },
    "All Numbers" : {
      "localizations" : {
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "සියලු ඉලක්කම්"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "அனைத்து எண்கள்"
          }
        }
      }
    },
    "All of this child's stars, badges and tracing history will be deleted. This cannot be undone." : {
      "localizations" : {
        "si" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "මෙම දරුවාගේ සියලු තරු, පදක්කම් සහ ඇඳීම් ඉතිහාසය මකා දැමෙනු ඇත. මෙය අහෝසි කළ නොහැක."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "இந்தக் குழந்தையின் அனைத்து நட்சத்திரங்கள், பதக்கங்கள் மற்றும் வரைதல் வரலாறு நீக்கப்படும். இதைச் செயல்தவிர்க்க முடியாது."
          }
        }
      }
    },
    "Answer the question to continue" : {
      "localizations" : {
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ඉදිරියට යාමට ප්‍රශ්නයට පිළිතුරු දෙන්න"
